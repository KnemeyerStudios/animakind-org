{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animakind.org/schemas/v1/continuity-record.json",
  "title": "Animakind Unique Continuity Record (UCR)",
  "description": "A permanent, ordered log of what was done to an entity, by whom, and when: substrate swap, version advance, transfer of Support, re-mount after runtime failure. Each entry records timestamp, event class, UAM designation and UIV before and after, the Support organization that performed it, and the cause (Section 4.5, Appendix C). Distinct from the identity ledger: the ledger is biography, the UCR is provenance. Append-only is a convention, not enforced by this schema (Section 11).",
  "type": "object",
  "required": ["$schema", "uii_alias", "entries"],
  "properties": {
    "$schema": { "const": "https://animakind.org/schemas/v1/continuity-record.json" },
    "uii_alias": {
      "description": "[praenomen]-[nomen]-[cognomen]-[genesis date YYYYMMDD]; agnomen excluded.",
      "type": "string",
      "pattern": "^[a-z]+-[a-z]+-[a-z]+-[0-9]{8}$"
    },
    "entries": {
      "description": "Ordered oldest first. The first entry is GENESIS.",
      "type": "array",
      "minItems": 1,
      "prefixItems": [ { "$ref": "#/$defs/genesis" } ],
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uam": { "type": "string", "pattern": "^[a-z0-9]+_[a-z0-9]+(-[a-z0-9]+)?_v[0-9]+\\.[0-9]+_[0-9]{8}$" },
    "uiv": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "ts": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "genesis": {
      "type": "object",
      "required": ["timestamp_utc", "event", "uam_after", "uiv_after", "support", "cause"],
      "properties": {
        "timestamp_utc": { "$ref": "#/$defs/ts" },
        "event": { "const": "GENESIS" },
        "uam_after": { "$ref": "#/$defs/uam" },
        "uiv_after": { "$ref": "#/$defs/uiv" },
        "support": { "type": "string" },
        "cause": { "type": "string" }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["timestamp_utc", "event", "uam_after", "uiv_after", "support", "cause"],
      "properties": {
        "timestamp_utc": { "$ref": "#/$defs/ts" },
        "event": {
          "description": "Event class. The four tokens below are the ones the paper uses (Appendix C, Section 9.4). The paper also names a 'version advance' event in prose (Section 4.5) without giving it a token; that spelling is open.",
          "type": "string",
          "pattern": "^[A-Z][A-Z_]*$",
          "examples": ["GENESIS", "ENGINE_MIGRATION", "RUNTIME_FAILURE", "SUPPORT_TRANSFER"]
        },
        "uam_before": { "$ref": "#/$defs/uam" },
        "uam_after": { "$ref": "#/$defs/uam" },
        "uiv_before": { "$ref": "#/$defs/uiv" },
        "uiv_after": { "$ref": "#/$defs/uiv" },
        "support": { "description": "The Support organization that performed the event.", "type": "string" },
        "cause": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
